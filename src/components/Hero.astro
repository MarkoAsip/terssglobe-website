---
import { site } from "../site.config";
const acc = site.taglineAccent;
const hasAcc = acc && site.tagline.endsWith(acc);
const lead = hasAcc ? site.tagline.slice(0, -acc.length) : site.tagline;
---

<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow">WEB + MOBILNE APLIKACIJE</p>
    <h1>{lead}{hasAcc && <span class="accent">{acc}</span>}</h1>
    <p class="muted lead">{site.description}</p>
    <div class="hero-cta">
      <a href="#kontakt" class="btn">Kontaktirajte nas</a>
      <a href={`tel:${site.phoneHref}`} class="btn btn-outline">{site.phone}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 6rem 0 5.5rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--primary) 11%, #fff);
  }
  .hero-inner { max-width: 780px; position: relative; }
  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
    background: #fff;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }
  h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .accent { color: var(--accent); }
  .lead { font-size: 1.18rem; margin-bottom: 2rem; max-width: 620px; }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
