---
import { pricing } from "../site.config";
---

{pricing.enabled && (
  <section id="cjenik" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>{pricing.title}</h2>
        <p class="muted">{pricing.subtitle}</p>
      </div>
      <div class="plans">
        {pricing.plans.map((p) => (
          <div class={`plan${p.highlighted ? " hot" : ""}`}>
            {p.highlighted && <div class="badge">Najpopularnije</div>}
            <h3>{p.name}</h3>
            <div class="price">{p.price}</div>
            <ul>
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a href="#kontakt" class={`btn${p.highlighted ? "" : " btn-outline"}`}>Odaberi</a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .plans { display: grid; gap: 1.5rem; }
  @media (min-width: 780px) { .plans { grid-template-columns: repeat(3, 1fr); align-items: start; } }
  .plan {
    background: var(--bg);
    border: 1px solid #eaecef;
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
    position: relative;
  }
  .plan.hot { border-color: var(--primary); box-shadow: 0 12px 30px rgba(30,90,168,0.12); }
  .badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: var(--primary); color: #fff; font-size: 0.72rem; font-weight: 700;
    padding: 0.25rem 0.75rem; border-radius: 999px; letter-spacing: 0.02em;
  }
  .price { font-size: 2rem; font-weight: 800; color: var(--primary); margin: 0.5rem 0 1rem; }
  .plan ul { list-style: none; margin: 0 0 1.5rem; display: grid; gap: 0.5rem; }
  .plan li { color: var(--muted); font-size: 0.95rem; }
  .plan li::before { content: "✓ "; color: var(--primary); font-weight: 700; }
</style>
