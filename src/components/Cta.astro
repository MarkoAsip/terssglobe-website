---
import { cta } from "../site.config";
---

{cta.enabled && (
  <section id="upitnik-cta">
    <div class="container band">
      <div class="txt">
        <h2>{cta.title}</h2>
        <p>{cta.text}</p>
      </div>
      <div class="btns">
        {cta.buttons.map((b, i) => (
          <a href={b.href} class={`btn cta-btn${i > 0 ? " secondary" : ""}`}>{b.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  #upitnik-cta { padding: 3rem 0; }
  .band {
    background: var(--primary);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .txt h2 { color: #fff; margin-bottom: 0.4rem; }
  .txt p { color: rgba(255, 255, 255, 0.9); margin: 0; max-width: 46ch; }
  .btns { display: flex; gap: 0.75rem; flex-wrap: wrap; flex-shrink: 0; }
  .cta-btn {
    background: #fff;
    color: var(--primaryDark);
    white-space: nowrap;
  }
  .cta-btn:hover { background: color-mix(in srgb, var(--primary) 8%, #fff); color: var(--primaryDark); }
  .cta-btn.secondary {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.7);
  }
  .cta-btn.secondary:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  @media (max-width: 620px) {
    .band { margin-inline: 0.75rem; padding: 1.75rem 1.25rem; }
    .btns { width: 100%; flex-direction: column; align-items: stretch; }
    .cta-btn { width: 100%; max-width: 320px; align-self: center; padding-inline: 0.9rem; text-align: center; white-space: nowrap; }
  }
</style>
