---
import { team } from "../site.config";

function initials(name: string) {
  return name.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase();
}
---

{team.enabled && (
  <section id="tim" class="alt">
    <div class="container">
      <div class="section-head">
        <h2>{team.title}</h2>
        <p class="muted">{team.subtitle}</p>
      </div>
      <div class="grid grid-3">
        {team.members.map((m) => (
          <article class="member">
            {m.img
              ? <img src={m.img} alt={m.name} loading="lazy" />
              : <div class="avatar">{initials(m.name)}</div>}
            <h3>{m.name}</h3>
            <p class="muted role">{m.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .member { text-align: center; }
  .member img, .avatar {
    width: 110px; height: 110px; border-radius: 50%;
    margin: 0 auto 0.9rem; object-fit: cover; display: block;
  }
  .avatar {
    display: grid; place-items: center;
    background: var(--primary); color: #fff;
    font-size: 2rem; font-weight: 700;
  }
  .member h3 { font-size: 1.1rem; }
  .role { font-size: 0.9rem; }
</style>
